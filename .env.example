MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=trueface
APP_URL=http://localhost:3000
# Optional comma-separated extra hostnames accepted by the backend proxy.
ALLOWED_HOSTS=
API_INTERNAL_URL=http://127.0.0.1:8001

# Generate unique production values. Never reuse these examples.
AUTH_SECRET=replace-with-at-least-32-random-characters
SETTINGS_MASTER_KEY=replace-with-base64-encoded-32-byte-key

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional environment fallbacks. Values saved in /admin/providers override
# these per field and are encrypted in MongoDB.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
EMAIL_PROVIDER=
EMAIL_SENDER=
EMAIL_SENDER_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# Optional AI orchestration and cloud inference fallbacks. Admin values saved
# in /admin/providers override these fields and are encrypted in MongoDB.
# Emergent LLM does not transform realtime video frames.
EMERGENT_LLM_API_KEY=
EMERGENT_LLM_BASE_URL=
EMERGENT_LLM_MODEL=emergent-universal
EMERGENT_LLM_CHAT_PATH=/chat/completions
AI_FACE_PROVIDER=local
GPU_PROVIDER=
GPU_INFERENCE_URL=
GPU_INFERENCE_API_KEY=
GPU_HEALTH_URL=
