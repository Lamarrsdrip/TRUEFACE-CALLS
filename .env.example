MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=trueface
APP_URL=http://localhost:3000
# Optional comma-separated extra hostnames accepted by the backend proxy.
ALLOWED_HOSTS=
API_INTERNAL_URL=http://127.0.0.1:8001

# Generate unique production values. Never reuse these examples.
AUTH_SECRET=replace-with-at-least-32-random-characters
SETTINGS_MASTER_KEY=replace-with-base64-encoded-32-byte-key

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional environment fallbacks. Values saved in /admin/providers override
# these per field and are encrypted in MongoDB.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
EMAIL_PROVIDER=
EMAIL_SENDER=
EMAIL_SENDER_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# Optional Emergent AI gateway fallbacks. Browser processing works without
# these. Configure only if Emergent exposes a deploy-time AI gateway for the
# project; admin values override these environment values.
EMERGENT_AI_GATEWAY_URL=
EMERGENT_AI_UNIVERSAL_KEY=
