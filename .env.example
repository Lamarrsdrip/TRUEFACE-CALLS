NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

DATABASE_URL=postgresql://trueface:trueface@localhost:5432/trueface?schema=public
DIRECT_DATABASE_URL=postgresql://trueface:trueface@localhost:5432/trueface?schema=public
REDIS_URL=redis://localhost:6379

AUTH_SECRET=replace-with-at-least-32-random-characters
SETTINGS_MASTER_KEY=replace-with-base64-encoded-32-byte-key
COOKIE_DOMAIN=

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_PREVIEW_EMAIL=viewer@example.com
BOOTSTRAP_PREVIEW_PASSWORD=replace-with-a-different-strong-password

# Optional deployment fallbacks. Prefer configuring these in Admin > Providers.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
